# Modello delle variabili d'ambiente di Orienta.
# Copialo in `.env.example` (file locale, ignorato da Git: l'app legge quello) e compila i valori.
# Non committare mai chiavi o password.
# Le altre variabili di Hackathon Starter servono solo alle sue pagine di esempio: vedi docs/HACKATHON-STARTER.md.

BASE_URL=http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/orienta
SESSION_SECRET=

# IA (senza chiave l'app usa la modalità di riserva basata sui manuali)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=low     # modelli Gemini 3.x: "low" o "minimal" per risposte più rapide
# AI_MOCK=1                     # forza la modalità di riserva
# COMUNEPILOT_LIVE_AI=false     # usa i contenuti predefiniti della demo scriptata

# Valori fittizi per inizializzare le strategie OAuth dello Starter in locale.
# Per gli accessi social, configura le credenziali dei rispettivi fornitori.
DISCORD_CLIENT_ID=orienta-demo-placeholder
DISCORD_CLIENT_SECRET=orienta-demo-placeholder
FACEBOOK_ID=orienta-demo-placeholder
FACEBOOK_SECRET=orienta-demo-placeholder
GITHUB_ID=orienta-demo-placeholder
GITHUB_SECRET=orienta-demo-placeholder
GOOGLE_CLIENT_ID=orienta-demo-placeholder
GOOGLE_CLIENT_SECRET=orienta-demo-placeholder
LINKEDIN_ID=orienta-demo-placeholder
LINKEDIN_SECRET=orienta-demo-placeholder
MICROSOFT_CLIENT_ID=orienta-demo-placeholder
MICROSOFT_CLIENT_SECRET=orienta-demo-placeholder
QUICKBOOKS_CLIENT_ID=orienta-demo-placeholder
QUICKBOOKS_CLIENT_SECRET=orienta-demo-placeholder
STEAM_KEY=orienta-demo-placeholder
TUMBLR_KEY=orienta-demo-placeholder
TUMBLR_SECRET=orienta-demo-placeholder
TWITCH_CLIENT_ID=orienta-demo-placeholder
TWITCH_CLIENT_SECRET=orienta-demo-placeholder
X_KEY=orienta-demo-placeholder
X_SECRET=orienta-demo-placeholder

# Segnaposto per i client Stripe e Twilio inizializzati dallo Starter.
STRIPE_SKEY=orienta-demo-placeholder
TWILIO_SID=AC00000000000000000000000000000000
TWILIO_TOKEN=orienta-demo-placeholder
