extends layout

block content
  a.cp-back(href=workspaceHref('/'))
    i.fa-solid.fa-arrow-left(aria-hidden='true')
    | Il mio percorso
  header.cp-page-intro
    span.cp-eyebrow Primo accesso
    h1 Benvenuta/o nel Comune di Vallechiara
    p= 'Area di lavoro: ' + workspace.label + '. Apri la microlezione, prova un ripasso e usa l’assistente quando ti serve una procedura.'
  .cp-home-grid
    section.cp-card.cp-document(aria-labelledby='welcome-path')
      h2#welcome-path Il tuo percorso iniziale
      ol.cp-steps
        li
          a.cp-text-link(href=navLesson) Prima microlezione
        li
          a.cp-text-link(href=workspaceHref('/quiz')) Primo ripasso
        li
          a.cp-text-link(href=workspaceHref('/assistente')) Prova l’assistente
      a.cp-btn.cp-btn-primary(href=navLesson) Inizia il percorso
    section.cp-card.cp-document(aria-labelledby='welcome-skills')
      h2#welcome-skills Le mie competenze
      each skill in topics.length ? topics : ['Anagrafe', 'Elettorale', 'Stato civile']
        .cp-skill
          .cp-skill-label
            strong= skill
            span.cp-skill-status Da iniziare
            span.cp-skill-score 0%
          progress.cp-progress(value='0', max='100', aria-label=skill)
