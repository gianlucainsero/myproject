extends layout

block content
  - const levels = [{ label: 'Risposta diretta', icon: 'fa-circle-check', description: 'I passi da fare e il manuale da cui li ho presi.' }, { label: 'Ti guido io', icon: 'fa-list-check', description: 'Ti faccio qualche domanda e ti preparo una checklist.' }, { label: 'Ticket assistenza', icon: 'fa-ticket', description: 'Preparo la richiesta. La confermi tu nella coda simulata.' }];
  header.cp-page-intro
    span.cp-eyebrow Cityware Online
    h1 Assistente
    p Chiedi una procedura di Cityware Online o descrivi un problema operativo.
  .cp-detail-grid.cp-assistant-grid
    section.cp-card.cp-chat(aria-label='Conversazione con l’assistente')
      header.cp-chat-header
        .cp-feature-icon
          i.fa-solid.fa-comment-dots(aria-hidden='true')
        div
          h2= `Assistente ${productName}`
          p= assistantMode
        button#new-case.cp-btn.cp-btn-outline(type='button', hidden) Nuova domanda
      ol.cp-stepper(aria-label='Livello di aiuto')
        each level, index in levels
          li.cp-step(class=`level-${index + 1}`, data-assistant-level=index + 1, data-label=level.label, data-icon=level.icon)
            span.cp-step-number(aria-hidden='true')= index + 1
            span= level.label
            span.cp-step-current(aria-hidden='true') Attivo
      #messages.cp-messages(role='log', aria-live='polite', aria-relevant='additions text')
        #empty-chat.cp-empty-chat
          h3 Come posso aiutarti?
          p Prova a partire da una di queste domande.
          .cp-prompts
            button(type='button', data-prompt='Come preparo il Rilascio CIE in Gestione Carte d’identità in Cityware?') Come rilascio una carta d’identità?
            button(type='button', data-prompt='Elezioni amministrative: devo aprire una nuova tornata in Cityware, da dove partire?') Da dove parto per aprire la tornata elettorale?
            button(type='button', data-prompt='Stampa Liste Sezionali: errore nella funzione di stampa 322, anche con un testo cwd corretto. L’ufficio è bloccato e la consegna è oggi.') La stampa delle liste sezionali è bloccata.
      p#chat-error.cp-form-error(role='alert', hidden)
      form#chat-form.cp-composer
        label.visually-hidden(for='chat-input') Scrivi una domanda
        input#chat-input(name='message', placeholder='Scrivi una domanda…', required, maxlength='1500', autocomplete='off')
        button.cp-btn.cp-btn-primary(type='submit')
          | Invia
          i.fa-solid.fa-arrow-up(aria-hidden='true')
      p.cp-chat-note Usa dati di esempio e ometti i dati personali.
    aside.cp-card.cp-document.cp-chat-aside
      h2 Come ti aiuto
      ol.cp-level-list
        each level, index in levels
          li
            span.cp-level-tag(class=`level-${index + 1}`, aria-hidden='true')
              i.fa-solid(class=level.icon)
              = index + 1
            div
              strong= level.label
              p= level.description
  template#ticket-template
    form.cp-ticket-form
      .cp-ticket
        header.cp-ticket-heading
          h3 Bozza ticket
          span(data-ticket-module)
        dl.cp-ticket-preview
          dt Oggetto
          dd(data-ticket-summary)
          dt Tipo
          dd
            span.cp-type-tag(data-ticket-type)
          dt Priorità
          dd(data-ticket-priority)
          dt Cosa hai provato
          dd(data-ticket-attempts)
        .cp-ticket-editor(hidden)
          label
            | Oggetto
            input(name='summary', required, maxlength='140')
          label
            | Descrizione
            textarea(name='description', required, maxlength='2500', rows='3')
          label
            | Cosa hai provato
            textarea(name='stepsTried', maxlength='1200', rows='2')
          .cp-fields
            label
              | Tipo
              select(name='type', required)
                option(value='bug') Possibile bug
                option(value='configurazione') Configurazione
                option(value='formazione') Formazione
                option(value='altro') Supporto operativo
            label
              | Impatto
              select(name='impact', required)
                option(value='limitato') Limitato
                option(value='operatore') Singolo operatore
                option(value='ufficio') Ufficio bloccato
            label
              | Urgenza
              select(name='urgency', required)
                option(value='nessuna') Nessuna scadenza
                option(value='presto') A breve
                option(value='oggi') Entro oggi
          p.cp-priority(aria-live='polite')
      .cp-chat-actions
        button.cp-btn.cp-btn-ticket(type='submit')
          i.fa-solid.fa-paper-plane(aria-hidden='true')
          | Invia il ticket
        button.cp-btn.cp-btn-outline(type='button', data-ticket-edit) Modifica
      p.cp-ticket-note Invio nella coda simulata.
      p.cp-form-error(role='alert', hidden)

block scripts
  script(src='/js/comunepilot.js?v=' + getFileHash('/js/comunepilot.js'), defer)
