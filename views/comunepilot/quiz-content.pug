section#quiz.cp-card.cp-document.cp-quiz(data-topic=topic, data-area=quizArea, data-assignment=assignmentId, data-back-href=back && back.href, data-back-label=back && back.label, data-review-href=reviewLink && reviewLink.href, data-review-label=reviewLink && reviewLink.label, aria-label='Mini-quiz')
  .cp-quiz-start
    .cp-study-heading
      .cp-feature-icon
        i.fa-solid.fa-list-check(aria-hidden='true')
      div
        h2 Pronto per la verifica?
        p Dopo ogni risposta vedrai una spiegazione e il riferimento al manuale.
    if latest && latest.topic === topic
      p= 'Ultimo risultato: ' + latest.score + ' su ' + latest.questions.length
    button#start-quiz.cp-btn.cp-btn-secondary(type='button') Inizia il quiz
  p#quiz-status(role='status', hidden)
  #quiz-body
  p#quiz-error.cp-form-error(role='alert', hidden)
