extends layout

block content
  - const cie = latest ? Math.round((100 * latest.score) / latest.questions.length) : null;
  - const electionScore = electionQuiz ? Math.round((100 * electionQuiz.score) / electionQuiz.questions.length) : null;
  - const skills = [{ label: 'Anagrafe', value: 72, example: true }, { label: 'Carte d’identità', value: cie }, { label: 'Elettorale', value: electionScore ?? 45, example: !electionQuiz }, { label: 'Stato civile', value: null }];
  - const remaining = lessons.length ? lessons.filter((lesson) => lesson.score === null).length : Number(!latest) + Number(!electionQuiz);
  header.cp-page-intro.cp-home-intro
    div
      h1 Buongiorno
      p= workspace.label + ' · Comune di Vallechiara'
    a.cp-text-link.cp-first-visit(href=workspaceHref('/benvenuto'))
      i.fa-solid.fa-user-plus(aria-hidden='true')
      | Guida al primo accesso

  if completedReview
    p.cp-feedback.cp-feedback-success(role='status') Ripasso completato. I tuoi progressi sono stati registrati.

  .cp-home-reviews(class=assignment ? 'has-assignment' : undefined)
    if assignment
      section.cp-review-banner.cp-assignment-banner.cp-card(aria-labelledby='assignment-title')
        .cp-feature-icon
          i.fa-solid.fa-list-check(aria-hidden='true')
        div
          .cp-assignment-heading
            h2#assignment-title Nuovo ripasso da Palitalsoft
            span.cp-new-badge NUOVO
          p
            strong= assignment.title
          p Creato da Palitalsoft dalle difficoltà dei colleghi
        a.cp-btn.cp-btn-white(href=workspaceHref('/ripasso/' + assignment.id))
          | Inizia
          i.fa-solid.fa-arrow-right(aria-hidden='true')
    section#ripassi.cp-review-banner.cp-daily-banner.cp-card(tabindex='-1', aria-labelledby='ripassi-title')
      .cp-feature-icon
        i.fa-solid.fa-list-check(aria-hidden='true')
      h2#ripassi-title= remaining === 2 ? 'Oggi hai 2 ripassi da fare' : remaining === 1 ? 'Oggi hai 1 ripasso da fare' : 'Ripassi di oggi completati'
      .cp-daily-actions
        if lessons.length
          each lesson in lessons
            a.cp-btn.cp-btn-white(href=lesson.quizUrl, aria-label=(lesson.score === null ? 'Inizia il ripasso ' : 'Ripeti il ripasso ') + lesson.topic)
              if lesson.score !== null
                i.fa-solid.fa-circle-check(aria-hidden='true')
              = lesson.topic
        else
          a.cp-btn.cp-btn-white(href='/quiz?da=percorso', aria-label=latest ? 'Ripeti il ripasso Carte d’identità' : 'Inizia il ripasso Carte d’identità')
            if latest
              i.fa-solid.fa-circle-check(aria-hidden='true')
            | Carte d’identità
          a.cp-btn.cp-btn-white(href=electionQuizUrl, aria-label=electionQuiz ? 'Ripeti il ripasso Elettorale' : 'Inizia il ripasso Elettorale')
            if electionQuiz
              i.fa-solid.fa-circle-check(aria-hidden='true')
            | Elettorale

  .cp-home-grid
    section.cp-card.cp-document(aria-labelledby='path-title')
      h2#path-title Il mio percorso
      p I moduli del tuo Comune.
      if lessons.length
        ul.cp-module-list
          each lesson in lessons
            li
              .cp-feature-icon
                i.fa-solid(class=lesson.icon, aria-hidden='true')
              div
                a.cp-text-link(href=lesson.href)= lesson.title
                small Microlezione e quiz
              span.cp-module-status(class=lesson.score === null ? '' : 'is-complete')= lesson.score === null ? 'Da iniziare' : 'Completato'
        - const nextLesson = lessons.find((lesson) => lesson.score === null);
        a.cp-btn.cp-btn-outline(href=(nextLesson || lessons[0]).href)= nextLesson ? 'Continua il percorso' : 'Rivedi la microlezione'
      else
        ul.cp-module-list
          li
            .cp-feature-icon
              i.fa-solid.fa-book-open(aria-hidden='true')
            div
              strong Anagrafe di base
              small Dati simulati
            span.cp-module-status.is-complete Completato
          li
            .cp-feature-icon
              i.fa-regular.fa-id-card(aria-hidden='true')
            div
              a.cp-text-link(href='/formazione/cie') Carta d’identità elettronica
              small Microlezione con video e quiz
            span.cp-module-status(class=latest ? 'is-complete' : '')= latest ? 'Completato' : 'Da iniziare'
          li
            .cp-feature-icon
              i.fa-solid.fa-list-check(aria-hidden='true')
            .cp-module-details
              strong Elezioni e liste elettorali
              a.cp-text-link(href=electionQuizUrl) Fai il ripasso elettorale
            span.cp-module-status(class=electionQuiz ? 'is-complete' : 'is-active')= electionQuiz ? 'Completato' : 'In corso'
          li
            .cp-feature-icon
              i.fa-solid.fa-file-lines(aria-hidden='true')
            strong Stato civile
            span.cp-module-status Da iniziare
        .cp-path-actions
          a.cp-btn.cp-btn-outline(href=latest && !electionQuiz ? electionQuizUrl : '/formazione/cie')= remaining ? 'Continua il percorso' : 'Rivedi la microlezione CIE'

    .cp-home-side
      section.cp-card.cp-document(aria-labelledby='skills-title')
        h2#skills-title(tabindex='-1') Le mie competenze
        p In base ai ripassi completati.
        each skill in lessons.length ? lessons.map((lesson) => ({ label: lesson.topic, value: lesson.score })) : skills
          .cp-skill
            .cp-skill-label
              strong= skill.label
              span.cp-skill-status= skill.value === null ? 'Da iniziare' : skill.value >= 67 ? 'Buono' : 'Da ripassare'
              if skill.example
                span.cp-sample-mark Dati simulati
              if skill.value !== null
                span.cp-skill-score= `${skill.value}%`
            progress.cp-progress(value=skill.value === null ? 0 : skill.value, max='100', aria-label=skill.label)
        if !lessons.length && latest
          p= `Ultimo mini-quiz CIE: ${latest.score} su ${latest.questions.length} risposte corrette.`

      section.cp-card.cp-help(aria-labelledby='aiuto-title')
        .cp-feature-icon
          i.fa-regular.fa-comments(aria-hidden='true')
        h2#aiuto-title Hai un dubbio?
        a.cp-btn.cp-btn-help(href=workspaceHref('/assistente')) Chiedi all’assistente
