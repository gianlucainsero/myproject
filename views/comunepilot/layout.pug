doctype html
html(lang='it')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='csrf-token', content=_csrf)
    title= `${title} | ${productName}`
    link(rel='stylesheet', href='/css/main.css?v=' + getFileHash('/css/main.css'))
    include ../partials/orienta-head
    link(rel='stylesheet', href='/css/comunepilot.css?v=' + getFileHash('/css/comunepilot.css'))
  body.cp-app(data-workspace=workspace.id)
    a.cp-skip(href='#contenuto') Vai al contenuto
    mixin navLink(key, label, href, icon)
      - const current = page === key ? 'page' : key === 'home' && ['welcome', 'manual'].includes(page) ? 'location' : undefined;
      a.cp-nav-link(href=href, class=current ? 'is-active' : '', aria-current=current)
        i.fa-solid(aria-hidden='true', class=icon)
        span= label
    header.cp-header
      include ../partials/orienta-brand
      .cp-header-actions
        span.cp-demo-badge
          span(aria-hidden='true')
          | Ambiente demo
        a.cp-account(href=user ? '/account' : '/login', aria-label=user ? 'Il mio account' : 'Accedi')
          i.fa-solid.fa-user(aria-hidden='true')
          span= user ? 'Account' : 'Accedi'
    .cp-frame
      aside.cp-sidebar
        details.cp-area-switch
          summary
            .cp-workspace-icon
              i.fa-solid(class=workspace.icon, aria-hidden='true')
            .cp-area-current
              span Area di lavoro
              strong= workspace.label
            i.fa-solid.fa-chevron-down.cp-area-chevron(aria-hidden='true')
          ul.cp-area-options(aria-label='Aree di lavoro')
            each item in workspaces
              li
                a(href=item.id === workspace.id ? undefined : areaLink(item.id), data-switch-area=item.id, aria-current=item.id === workspace.id ? 'true' : undefined)
                  i.fa-solid(class=item.icon, aria-hidden='true')
                  span= item.label
                  if item.id === workspace.id
                    i.fa-solid.fa-check(aria-hidden='true')
        nav.cp-navigation(aria-label='Navigazione principale')
          .cp-nav-group(role='group', aria-labelledby='nav-operator')
            p#nav-operator.cp-nav-label Spazio operatore
            +navLink('home', 'Il mio percorso', workspaceHref('/'), 'fa-book-open')
            +navLink('lesson', workspace.id === 'demografici' ? 'Microlezione CIE' : 'Microlezione', navLesson, 'fa-circle-play')
            +navLink('quiz', 'Mini-quiz', workspaceHref('/quiz'), 'fa-list-check')
            +navLink('assistant', 'Assistente', workspaceHref('/assistente'), 'fa-comment-dots')
          .cp-nav-group(role='group', aria-labelledby='nav-trainer')
            p#nav-trainer.cp-nav-label Spazio formatore
            +navLink('dashboard', 'Cruscotto', workspaceHref('/palitalsoft'), 'fa-chart-column')
      main#contenuto.cp-main(tabindex='-1')
        .cp-content
          block content
    block scripts
